# LLM_MODE   = brain that answers "what if" questions
# DAILY_MODE = brain that writes daily insights and the life profile (sees whole diary entries)
#
# local = Ollama on this PC, nothing leaves the computer
# groq  = Groq cloud API, only anonymised excerpts are sent
# cloud = Anthropic Claude API, only anonymised excerpts are sent
# mock  = fake answers, for testing
LLM_MODE=groq
DAILY_MODE=local

# groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# local (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# cloud (Anthropic), only used when a mode is set to cloud
ANTHROPIC_API_KEY=
CLOUD_MODEL=claude-sonnet-5-5

# Names hidden before anything is sent to a cloud model (comma separated)
PRIVATE_NAMES=

# Max characters of each diary entry sent to a cloud model
SNIPPET_CHARS=600

# Time of the automatic daily update (24h, local time)
DAILY_UPDATE_AT=22:00

PORT=8765
